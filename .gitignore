# Plugin and session state
.remember/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The reference library: a copy of public data, rebuilt by scripts/make_reference.py
reference/*
!reference/README.md

# Analysis outputs and preserved study data: kept on disk, never in git, never source code
data/

# Credentials. Onshape API keys and model tokens live here.
.env

# The UI's dependencies and build. `npm install` and `npm run build` make both.
ui/node_modules/
ui/dist/
ui/tsconfig.tsbuildinfo

# Parasolid exports. Nothing in this stack can read them — OCCT has no Parasolid reader — so one
# in assets/ would claim to be an input the platform uses and is not.
*.x_t

# What the meshers leave in the working directory
*_skipped.face
*_skipped.node
*__tracked_surface.stl
tetgen-tmpfile*

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
