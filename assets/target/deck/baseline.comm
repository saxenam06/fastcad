DEBUT(LANG='EN')

mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('BULK',), PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('REFPT',), PHENOMENE='MECANIQUE', MODELISATION='DIS_TR'),
    ),
)

points = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=(
        _F(GROUP_MA=('REFPT',), CARA='K_TR_D_N', VALE=(0.0,) * 6),
    ),
)

iron = DEFI_MATERIAU(ELAS=_F(E=169000.0, NU=0.275, RHO=7.2e-09))

materials = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('BULK',), MATER=iron),
    ),
)

supports = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO=('ref_flange_bolt_00', 'ref_flange_bolt_01', 'ref_flange_bolt_02', 'ref_flange_bolt_03', 'ref_flange_bolt_04', 'ref_flange_bolt_05', 'ref_flange_bolt_06', 'ref_flange_bolt_07', 'ref_flange_bolt_08', 'ref_flange_bolt_09', 'ref_flange_bolt_10', 'ref_flange_bolt_11', 'ref_flange_bolt_12', 'ref_flange_bolt_13', 'ref_flange_bolt_14', 'ref_flange_bolt_15', 'ref_flange_bolt_16', 'ref_flange_bolt_17', 'ref_flange_bolt_18', 'ref_flange_bolt_19', 'ref_flange_bolt_20', 'ref_flange_bolt_21', 'ref_flange_bolt_22', 'ref_flange_bolt_23', 'ref_flange_bolt_24'), DX=0.0, DY=0.0, DZ=0.0),
    ),
    LIAISON_SOLIDE=(
        _F(GROUP_NO=('flange_bolt_00', 'ref_flange_bolt_00')),
        _F(GROUP_NO=('flange_bolt_01', 'ref_flange_bolt_01')),
        _F(GROUP_NO=('flange_bolt_02', 'ref_flange_bolt_02')),
        _F(GROUP_NO=('flange_bolt_03', 'ref_flange_bolt_03')),
        _F(GROUP_NO=('flange_bolt_04', 'ref_flange_bolt_04')),
        _F(GROUP_NO=('flange_bolt_05', 'ref_flange_bolt_05')),
        _F(GROUP_NO=('flange_bolt_06', 'ref_flange_bolt_06')),
        _F(GROUP_NO=('flange_bolt_07', 'ref_flange_bolt_07')),
        _F(GROUP_NO=('flange_bolt_08', 'ref_flange_bolt_08')),
        _F(GROUP_NO=('flange_bolt_09', 'ref_flange_bolt_09')),
        _F(GROUP_NO=('flange_bolt_10', 'ref_flange_bolt_10')),
        _F(GROUP_NO=('flange_bolt_11', 'ref_flange_bolt_11')),
        _F(GROUP_NO=('flange_bolt_12', 'ref_flange_bolt_12')),
        _F(GROUP_NO=('flange_bolt_13', 'ref_flange_bolt_13')),
        _F(GROUP_NO=('flange_bolt_14', 'ref_flange_bolt_14')),
        _F(GROUP_NO=('flange_bolt_15', 'ref_flange_bolt_15')),
        _F(GROUP_NO=('flange_bolt_16', 'ref_flange_bolt_16')),
        _F(GROUP_NO=('flange_bolt_17', 'ref_flange_bolt_17')),
        _F(GROUP_NO=('flange_bolt_18', 'ref_flange_bolt_18')),
        _F(GROUP_NO=('flange_bolt_19', 'ref_flange_bolt_19')),
        _F(GROUP_NO=('flange_bolt_20', 'ref_flange_bolt_20')),
        _F(GROUP_NO=('flange_bolt_21', 'ref_flange_bolt_21')),
        _F(GROUP_NO=('flange_bolt_22', 'ref_flange_bolt_22')),
        _F(GROUP_NO=('flange_bolt_23', 'ref_flange_bolt_23')),
        _F(GROUP_NO=('flange_bolt_24', 'ref_flange_bolt_24')),
    ),
)

couplings = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_RBE3=(
        _F(GROUP_NO_MAIT='ref_lss_carrier_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='lss_carrier_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='ref_lss_thrust_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='lss_thrust_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='ref_hss_upwind_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='hss_upwind_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='ref_hss_downwind_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='hss_downwind_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='ref_ims_upwind_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='ims_upwind_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='ref_ims_downwind_bearing', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='ims_downwind_bearing', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
    ),
)

loads = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=(
        _F(GROUP_NO='ref_lss_carrier_bearing', FX=57185.8, FY=-330205.7, FZ=71500.0),
        _F(GROUP_NO='ref_lss_thrust_bearing', FX=68936.2, FY=-148449.3, FZ=137023.1),
        _F(GROUP_NO='ref_hss_upwind_bearing', FX=5650.2, FY=55753.4, FZ=-0.0),
        _F(GROUP_NO='ref_hss_downwind_bearing', FX=9800.8, FY=35145.3, FZ=-21524.2),
        _F(GROUP_NO='ref_ims_upwind_bearing', FX=-57911.6, FY=5846.0, FZ=-0.0),
        _F(GROUP_NO='ref_ims_downwind_bearing', FX=-83661.3, FY=75243.6, FZ=-28263.9),
    ),
)

result = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=materials,
    CARA_ELEM=points,
    EXCIT=(_F(CHARGE=supports), _F(CHARGE=couplings), _F(CHARGE=loads),),
    SOLVEUR=_F(METHODE='MUMPS', ACCELERATION='LR', GESTION_MEMOIRE='AUTO', RENUM='AUTO'),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=('SIGM_NOEU',),
    CRITERES=('SIEQ_NOEU',),
    FORCE=('REAC_NODA',),
)

IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(RESULTAT=result, NOM_CHAM=('DEPL', 'SIGM_NOEU', 'SIEQ_NOEU', 'REAC_NODA')),
)

signals = POST_RELEVE_T(
    ACTION=(
        _F(INTITULE='lss_carrier_bearing', GROUP_NO='ref_lss_carrier_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='lss_thrust_bearing', GROUP_NO='ref_lss_thrust_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='hss_upwind_bearing', GROUP_NO='ref_hss_upwind_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='hss_downwind_bearing', GROUP_NO='ref_hss_downwind_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='ims_upwind_bearing', GROUP_NO='ref_ims_upwind_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='ims_downwind_bearing', GROUP_NO='ref_ims_downwind_bearing', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
    ),
)

IMPR_TABLE(TABLE=signals, UNITE=81, FORMAT='TABLEAU')

FIN()
