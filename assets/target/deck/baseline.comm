DEBUT(LANG='EN')

mesh = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)

model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('BULK',), PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('REFPT',), PHENOMENE='MECANIQUE', MODELISATION='DIS_TR'),
    ),
)

points = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=(
        _F(GROUP_MA=('REFPT',), CARA='K_TR_D_N', VALE=(0.0,) * 6),
    ),
)

iron = DEFI_MATERIAU(ELAS=_F(E=169000.0, NU=0.275, RHO=7.2e-09))

materials = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('BULK',), MATER=iron),
    ),
)

supports = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO=('REF_BOLT_00', 'REF_BOLT_01', 'REF_BOLT_02', 'REF_BOLT_03', 'REF_BOLT_04', 'REF_BOLT_05', 'REF_BOLT_06', 'REF_BOLT_07', 'REF_BOLT_08', 'REF_BOLT_09', 'REF_BOLT_10', 'REF_BOLT_11', 'REF_BOLT_12', 'REF_BOLT_13', 'REF_BOLT_14', 'REF_BOLT_15', 'REF_BOLT_16', 'REF_BOLT_17', 'REF_BOLT_18', 'REF_BOLT_19', 'REF_BOLT_20', 'REF_BOLT_21', 'REF_BOLT_22', 'REF_BOLT_23', 'REF_BOLT_24'), DX=0.0, DY=0.0, DZ=0.0),
    ),
    LIAISON_SOLIDE=(
        _F(GROUP_NO=('BOLT_00', 'REF_BOLT_00')),
        _F(GROUP_NO=('BOLT_01', 'REF_BOLT_01')),
        _F(GROUP_NO=('BOLT_02', 'REF_BOLT_02')),
        _F(GROUP_NO=('BOLT_03', 'REF_BOLT_03')),
        _F(GROUP_NO=('BOLT_04', 'REF_BOLT_04')),
        _F(GROUP_NO=('BOLT_05', 'REF_BOLT_05')),
        _F(GROUP_NO=('BOLT_06', 'REF_BOLT_06')),
        _F(GROUP_NO=('BOLT_07', 'REF_BOLT_07')),
        _F(GROUP_NO=('BOLT_08', 'REF_BOLT_08')),
        _F(GROUP_NO=('BOLT_09', 'REF_BOLT_09')),
        _F(GROUP_NO=('BOLT_10', 'REF_BOLT_10')),
        _F(GROUP_NO=('BOLT_11', 'REF_BOLT_11')),
        _F(GROUP_NO=('BOLT_12', 'REF_BOLT_12')),
        _F(GROUP_NO=('BOLT_13', 'REF_BOLT_13')),
        _F(GROUP_NO=('BOLT_14', 'REF_BOLT_14')),
        _F(GROUP_NO=('BOLT_15', 'REF_BOLT_15')),
        _F(GROUP_NO=('BOLT_16', 'REF_BOLT_16')),
        _F(GROUP_NO=('BOLT_17', 'REF_BOLT_17')),
        _F(GROUP_NO=('BOLT_18', 'REF_BOLT_18')),
        _F(GROUP_NO=('BOLT_19', 'REF_BOLT_19')),
        _F(GROUP_NO=('BOLT_20', 'REF_BOLT_20')),
        _F(GROUP_NO=('BOLT_21', 'REF_BOLT_21')),
        _F(GROUP_NO=('BOLT_22', 'REF_BOLT_22')),
        _F(GROUP_NO=('BOLT_23', 'REF_BOLT_23')),
        _F(GROUP_NO=('BOLT_24', 'REF_BOLT_24')),
    ),
)

couplings = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_RBE3=(
        _F(GROUP_NO_MAIT='REF_BORE_MAIN_S2', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_MAIN_S2', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='REF_BORE_MAIN_S3', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_MAIN_S3', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='REF_BORE_AX1_S1', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_AX1_S1', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='REF_BORE_AX1_S4', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_AX1_S4', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='REF_BORE_AX2_S2', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_AX2_S2', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
        _F(GROUP_NO_MAIT='REF_BORE_AX2_S3', DDL_MAIT=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'), GROUP_NO_ESCL='BORE_AX2_S3', DDL_ESCL=('DX-DY-DZ',), COEF_ESCL=(1.0,)),
    ),
)

loads = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=(
        _F(GROUP_NO='REF_BORE_MAIN_S2', FX=57185.8, FY=-330205.7, FZ=71500.0),
        _F(GROUP_NO='REF_BORE_MAIN_S3', FX=68936.2, FY=-148449.3, FZ=137023.1),
        _F(GROUP_NO='REF_BORE_AX1_S1', FX=5650.2, FY=55753.4, FZ=-0.0),
        _F(GROUP_NO='REF_BORE_AX1_S4', FX=9800.8, FY=35145.3, FZ=-21524.2),
        _F(GROUP_NO='REF_BORE_AX2_S2', FX=-57911.6, FY=5846.0, FZ=-0.0),
        _F(GROUP_NO='REF_BORE_AX2_S3', FX=-83661.3, FY=75243.6, FZ=-28263.9),
    ),
)

result = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=materials,
    CARA_ELEM=points,
    EXCIT=(_F(CHARGE=supports), _F(CHARGE=couplings), _F(CHARGE=loads),),
    SOLVEUR=_F(METHODE='MUMPS', ACCELERATION='LR', GESTION_MEMOIRE='AUTO', RENUM='AUTO'),
)

result = CALC_CHAMP(
    reuse=result,
    RESULTAT=result,
    CONTRAINTE=('SIGM_NOEU',),
    CRITERES=('SIEQ_NOEU',),
    FORCE=('REAC_NODA',),
)

IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(RESULTAT=result, NOM_CHAM=('DEPL', 'SIGM_NOEU', 'SIEQ_NOEU', 'REAC_NODA')),
)

signals = POST_RELEVE_T(
    ACTION=(
        _F(INTITULE='BORE_MAIN_S2', GROUP_NO='REF_BORE_MAIN_S2', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='BORE_MAIN_S3', GROUP_NO='REF_BORE_MAIN_S3', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='BORE_AX1_S1', GROUP_NO='REF_BORE_AX1_S1', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='BORE_AX1_S4', GROUP_NO='REF_BORE_AX1_S4', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='BORE_AX2_S2', GROUP_NO='REF_BORE_AX2_S2', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
        _F(INTITULE='BORE_AX2_S3', GROUP_NO='REF_BORE_AX2_S3', RESULTAT=result, NOM_CHAM='DEPL', TOUT_CMP='OUI', OPERATION='EXTRACTION'),
    ),
)

IMPR_TABLE(TABLE=signals, UNITE=81, FORMAT='TABLEAU')

FIN()
